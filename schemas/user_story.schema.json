{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user_story.schema.json",
  "title": "UserStory",
  "type": "object",
  "required": [
    "id",
    "ref",
    "subject",
    "project",
    "status",
    "version",
    "created_date",
    "modified_date"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "integer"},
    "ref": {"type": "integer"},
    "subject": {"type": "string"},
    "project": {"type": "integer"},
    "status": {"type": "integer"},
    "version": {"type": "integer"},
    "created_date": {"type": "string", "format": "date-time"},
    "modified_date": {"type": "string", "format": "date-time"},
    "assigned_to": {"type": ["integer", "null"]},
    "assigned_to_extra_info": {
      "type": ["object", "null"],
      "required": ["id", "username", "full_name_display", "is_active"],
      "properties": {
        "id": {"type": "integer"},
        "username": {"type": "string"},
        "full_name_display": {"type": "string"},
        "gravatar_id": {"type": "string"},
        "photo": {"type": ["string", "null"]},
        "big_photo": {"type": ["string", "null"]},
        "is_active": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "assigned_users": {"type": "array"},
    "attachments": {"type": "array"},
    "backlog_order": {"type": "integer"},
    "blocked_note": {"type": "string"},
    "blocked_note_html": {"type": "string"},
    "client_requirement": {"type": "boolean"},
    "comment": {"type": "string"},
    "description": {"type": ["string", "null"]},
    "description_html": {"type": ["string", "null"]},
    "due_date": {"type": ["string", "null"], "format": "date-time"},
    "due_date_reason": {"type": "string"},
    "due_date_status": {"type": "string"},
    "epic_order": {"type": ["integer", "null"]},
    "epics": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "ref", "subject", "color", "project"],
        "properties": {
          "id": {"type": "integer"},
          "ref": {"type": "integer"},
          "subject": {"type": "string"},
          "color": {"type": "string"},
          "project": {
            "type": "object",
            "required": ["id", "name", "slug"],
            "properties": {
              "id": {"type": "integer"},
              "name": {"type": "string"},
              "slug": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "external_reference": {"type": ["string", "null"]},
    "finish_date": {"type": ["string", "null"]},
    "generated_from_issue": {"type": ["integer", "null"]},
    "generated_from_task": {"type": ["integer", "null"]},
    "is_blocked": {"type": "boolean"},
    "is_closed": {"type": "boolean"},
    "is_voter": {"type": "boolean"},
    "is_watcher": {"type": "boolean"},
    "kanban_order": {"type": "integer"},
    "milestone": {"type": ["integer", "null"]},
    "milestone_name": {"type": ["string", "null"]},
    "milestone_slug": {"type": ["string", "null"]},
    "origin_issue": {"type": ["integer", "null"]},
    "origin_task": {"type": ["integer", "null"]},
    "owner": {"type": "integer"},
    "owner_extra_info": {
      "type": "object",
      "required": ["id", "username", "full_name_display", "is_active"],
      "properties": {
        "id": {"type": "integer"},
        "username": {"type": "string"},
        "full_name_display": {"type": "string"},
        "gravatar_id": {"type": "string"},
        "photo": {"type": ["string", "null"]},
        "big_photo": {"type": ["string", "null"]},
        "is_active": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "points": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "null"]}
    },
    "project_extra_info": {
      "type": "object",
      "required": ["id", "name", "slug"],
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "slug": {"type": "string"},
        "logo_small_url": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "sprint_order": {"type": "integer"},
    "status_extra_info": {
      "type": "object",
      "required": ["name", "color", "is_closed"],
      "properties": {
        "name": {"type": "string"},
        "color": {"type": "string"},
        "is_closed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string"},
          {"type": ["string", "null"]}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "tasks": {"type": "array"},
    "team_requirement": {"type": "boolean"},
    "total_attachments": {"type": "integer", "minimum": 0},
    "total_comments": {"type": "integer", "minimum": 0},
    "total_points": {"type": ["number", "null"]},
    "total_voters": {"type": "integer", "minimum": 0},
    "total_watchers": {"type": "integer", "minimum": 0},
    "tribe_gig": {"type": ["string", "null"]},
    "neighbors": {
      "type": "object",
      "properties": {
        "next": {
          "type": ["object", "null"],
          "required": ["id", "ref", "subject"],
          "properties": {
            "id": {"type": "integer"},
            "ref": {"type": "integer"},
            "subject": {"type": "string"}
          },
          "additionalProperties": true
        },
        "previous": {
          "type": ["object", "null"],
          "required": ["id", "ref", "subject"],
          "properties": {
            "id": {"type": "integer"},
            "ref": {"type": "integer"},
            "subject": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "watchers": {"type": "array"},
    "from_task_ref": {"type": ["integer", "null"]},
    "swimlane": {"type": ["integer", "null"]}
  }
}
