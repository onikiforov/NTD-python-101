# Taiga instance
TAIGA_BASE_URL=https://api.taiga.io/api/v1

# Credentials for an EXISTING Taiga.io account you own.
TAIGA_USERNAME=
TAIGA_PASSWORD=

# ID of a pre-existing project in your Taiga.io account.
# Create one project manually in the Taiga web UI before the workshop.
TAIGA_PROJECT_ID=

# Set url + port to use proxy
# Set SSL_VERIFY to False to ignore certificate check
HTTPS_PROXY=
SSL_VERIFY=True